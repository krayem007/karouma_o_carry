# ===== Configuration Base de Données =====
db = df
db_host = localhost
db_user = votre_utilisateur
db_password = votre_mot_de_passe

# ===== Configuration Email (Gmail API via HTTPS) =====
EMAIL_USER=votre.email@gmail.com
GMAIL_CLIENT_ID=votre_client_id
GMAIL_CLIENT_SECRET=votre_client_secret
GMAIL_REFRESH_TOKEN=votre_refresh_token

# ===== Email Admin pour notifications =====
ADMIN_EMAIL=admin@example.com

# ===== Clé secrète de session =====
# Générer une clé aléatoire avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=votre_cle_secrete_aleatoire
